# PUBLIC SITE
NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
NEXT_PUBLIC_BOOKING_PHONE=+1YOUR_TWILIO_NUMBER
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/YOUR_CALENDLY_SLUG/junk-pickup

# STRIPE — start with test keys, then switch to live after a successful test
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# TWILIO
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_FROM_PHONE=+1YOUR_TWILIO_NUMBER
# Alternative to TWILIO_FROM_PHONE:
# TWILIO_MESSAGING_SERVICE_SID=MG_REPLACE_ME

# NOTIFICATIONS
OWNER_PHONE=+1YOUR_NUMBER
BRANDON_PHONE=+18014589990

# CALENDLY AUTOMATIC BOOKING NOTIFICATIONS
# Generate in Calendly > Integrations > API & Webhooks
CALENDLY_PAT=REPLACE_ME
# Make this a long random private string
CALENDLY_WEBHOOK_KEY=REPLACE_WITH_LONG_RANDOM_STRING

# PRIVATE PHONE-FRIENDLY SETUP DASHBOARD
# Make this another long random private string
SETUP_KEY=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING

# OPTIONAL TRAFFIC ANALYTICS
NEXT_PUBLIC_GA_ID=G-REPLACE_ME
NEXT_PUBLIC_META_PIXEL_ID=REPLACE_ME
